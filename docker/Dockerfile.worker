# Celery worker container (Phase 10 background scan tasks). Same base
# as the backend image since it shares the exact same Python dependency
# set — kept as a separate Dockerfile (not just a different CMD override
# in docker-compose) so the worker's own image can be scanned/patched
# independently in CI if it ever needs a different dependency footprint.
FROM python:3.12-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN useradd --create-home --shell /usr/sbin/nologin appuser

COPY --chown=appuser:appuser . .

USER appuser

CMD ["celery", "-A", "backend.tasks.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
