# Copy this file to .env and fill in real values before running
# docker compose up. Never commit the actual .env file.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-generate-a-real-password

# --- Auth (Phase 18) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-generate-a-real-32-byte-hex-secret

# --- AI providers (Phase 12) — set at least one for the /analyze endpoint to work ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
